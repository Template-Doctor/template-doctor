{
  "name": "template-doctor-frontend",
  "version": "0.0.1",
  "description": "Template Doctor frontend",
  "scripts": {
    "test": "playwright test",
    "test:headless": "PLAYWRIGHT_HEADLESS=1 playwright test",
    "test:ui": "playwright test --ui",
    "test:debug": "playwright test --debug",
    "browsers:install": "playwright install chromium",
    "start": "python3 -m http.server 8080",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
  "build:analyzer": "node build-analyzer.js",
  "build": "npm run build:analyzer",
  "postinstall": "npm run build:analyzer"
  },
  "devDependencies": {
    "prettier": "^3.6.2",
    "esbuild": "^0.23.0"
  }
}
